{
  "name": "tokens",
  "description": "An admission token for downstream brokers appears under sys/tokens and goes.",
  "steps": [
    { "require": "wy/{site}/sys/tokens" },
    { "watch": "wy/{site}/sys/tokens" },
    { "invoke": "wy/{site}/sys/tokens", "action": "add", "args": { "count": 1, "hours": 1 } },
    { "added": "wy/{site}/sys/tokens", "name": "*", "save_as": "tok" },
    { "invoke": "wy/{site}/sys/tokens/{tok}", "action": "remove", "cleanup": true },
    { "removed": "wy/{site}/sys/tokens", "name": "{tok}", "cleanup": true }
  ]
}
