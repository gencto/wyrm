{
  "name": "history",
  "description": "A watch group and a watch appear with their callbacks (added under history, history changed under sys), refuse a second group of the same name, and go again.",
  "steps": [
    { "watch": "wy/{site}/sys" },
    { "watch": "wy/{site}/sys/history" },
    { "invoke": "wy/{site}/sys/history", "action": "add_watch_group",
      "args": { "name": "p{run}", "logging_type": "Interval", "interval": 5 } },
    { "added": "wy/{site}/sys/history", "name": "p{run}" },
    { "changed": "wy/{site}/sys", "name": "history" },
    { "meta": "wy/{site}/sys/history/p{run}", "has_action": ["add_watch_path", "edit", "remove"],
      "has_child": ["logging_type", "interval"] },
    { "invoke": "wy/{site}/sys/history", "action": "add_watch_group", "args": { "name": "p{run}" },
      "expect": "error", "error": "exists" },
    { "watch": "wy/{site}/sys/history/p{run}" },
    { "invoke": "wy/{site}/sys/history/p{run}", "action": "add_watch_path",
      "args": { "path": "downstream/probe/p{run}" } },
    { "added": "wy/{site}/sys/history/p{run}", "name": "w1" },
    { "meta": "wy/{site}/sys/history/p{run}/w1", "has_action": ["unsubscribe", "get_history"] },
    { "invoke": "wy/{site}/sys/history/p{run}/w1", "action": "unsubscribe" },
    { "removed": "wy/{site}/sys/history/p{run}", "name": "w1" },
    { "invoke": "wy/{site}/sys/history/p{run}", "action": "remove", "args": { "purge": true }, "cleanup": true },
    { "removed": "wy/{site}/sys/history", "name": "p{run}", "cleanup": true }
  ]
}
