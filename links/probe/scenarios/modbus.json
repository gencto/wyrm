{
  "name": "modbus",
  "description": "Modbus link (docs/modbus.md) on the demo's plc1 against wyrm-modbus-sim: diagnostics leaves and a value of one, read_registers and its bound, read_device_id, a folder with a point and its copy (polled), export of ahu1 and import as a new stopped device; all removed.",
  "steps": [
    { "require": "wy/{site}/sys/links/plc1" },
    { "require": "wy/{site}/downstream/plc1/line1" },
    { "require": "wy/{site}/downstream/plc1/line1/ahu1" },
    { "meta": "wy/{site}/downstream/plc1/line1", "has_action": ["add_device", "scan_units", "copy", "export", "import", "edit", "remove", "restart"], "has_child": ["status", "requests", "errors", "timeouts", "exceptions", "reopens", "last_rtt_ms", "avg_rtt_ms"] },
    { "meta": "wy/{site}/downstream/plc1/line1/ahu1", "has_action": ["add_point", "add_folder", "read_registers", "read_device_id", "copy", "export", "import"], "has_child": ["status", "requests", "timeouts", "reopens", "avg_rtt_ms"] },
    { "sub": "wy/{site}/downstream/plc1/line1/requests" },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1", "action": "read_registers", "args": { "table": "holding", "addr": 10, "count": 2, "dtype": "f32" } },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1", "action": "read_registers", "args": { "table": "holding", "addr": 0, "count": 126 }, "expect": "error", "error": "count" },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1", "action": "read_device_id" },
    { "meta": "wy/{site}/downstream/plc1/line1/requests", "type": "number" },
    { "value": "wy/{site}/downstream/plc1/line1/requests", "within_ms": 12000 },
    { "watch": "wy/{site}/downstream/plc1/line1/ahu1" },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1", "action": "add_folder", "args": { "name": "probe_f{run}" } },
    { "added": "wy/{site}/downstream/plc1/line1/ahu1", "name": "probe_f{run}" },
    { "watch": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}" },
    { "sub": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}/**" },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}", "action": "add_point", "args": { "name": "probe_p{run}", "table": "holding", "addr": 0, "dtype": "u16", "poll_s": 1 } },
    { "added": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}", "name": "probe_p{run}" },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}/probe_p{run}", "action": "copy", "args": { "name": "probe_c{run}" } },
    { "added": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}", "name": "probe_c{run}" },
    { "value": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}/probe_c{run}", "within_ms": 5000 },
    { "children": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}", "contains": ["probe_p{run}", "probe_c{run}"] },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1/probe_f{run}", "action": "remove", "cleanup": true },
    { "removed": "wy/{site}/downstream/plc1/line1/ahu1", "name": "probe_f{run}", "cleanup": true },
    { "watch": "wy/{site}/downstream/plc1/line1" },
    { "invoke": "wy/{site}/downstream/plc1/line1/ahu1", "action": "export", "save_as": "branch", "field": "json" },
    { "invoke": "wy/{site}/downstream/plc1/line1", "action": "import", "args": { "json": "{branch}", "name": "probe_d{run}" } },
    { "added": "wy/{site}/downstream/plc1/line1", "name": "probe_d{run}" },
    { "meta": "wy/{site}/downstream/plc1/line1/probe_d{run}", "has_action": ["start", "export"], "lacks_action": ["stop"], "has_child": ["counter", "setpoint", "status"] },
    { "invoke": "wy/{site}/downstream/plc1/line1/probe_d{run}", "action": "remove", "cleanup": true },
    { "removed": "wy/{site}/downstream/plc1/line1", "name": "probe_d{run}", "cleanup": true }
  ]
}
