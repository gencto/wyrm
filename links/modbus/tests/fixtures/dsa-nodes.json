        "@number of registers": 1,
        "@data type": "BOOLEAN",
        "@bit": -1,
        "@scaling": 1.0,
        "@scaling offset": 0.0,
        "@writable": true,
        "@restoreType": "point"
      },
      "Serial No": {
        "$is": "node",
