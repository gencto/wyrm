#!/bin/sh /etc/rc.common
# The WYRM broker under procd (ADR 0051 §1, §3).
#
# Before the broker starts, the first-boot script applies the configuration of the
# image's config region, once: the marker says that it did. An empty region leaves the
# image's default /etc/wyrm/wyrmd.json5 in place (loopback only, no admin).
#
# The broker is started as it is, not through `wyrmd update-guard`: self-update is off
# in images (ADR 0051 §3).

# shellcheck disable=SC2034 # read by rc.common
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

FIRST_BOOT=/usr/libexec/wyrm/first-boot.sh
MARKER=/etc/wyrm/.first-boot-done
DATA=/srv/wyrm

# to the system log (`logread -e wyrm`) and to the console of the device
tell() {
	logger -t wyrm "$1"
	echo "$1" > /dev/console 2> /dev/null
}

# The uci-defaults script runs the first boot before the network starts. This is the
# second chance when that run did not finish (exit 4 or 5), and the place where an
# empty region is told in the log.
first_boot() {
	[ -e "$MARKER" ] && return 0
	rc=0
	out=$("$FIRST_BOOT" 2>&1) || rc=$?
	if [ -n "$out" ]; then
		echo "$out" | while IFS= read -r line; do
			tell "$line"
		done
	fi
	# applied this late: the services that started with the old files read the new ones
	[ "$rc" -eq 0 ] && reload_config
	return 0
}

start_service() {
	first_boot
	mkdir -p "$DATA"
	chmod 700 "$DATA"

	procd_open_instance wyrmd
	procd_set_param command /usr/libexec/wyrm/run.sh
	# start again after a crash: at most 8 times within an hour, 5 s apart
	procd_set_param respawn 3600 5 8
	# SIGTERM ends the broker cleanly (history flushed, links told to stop)
	procd_set_param term_timeout 20
	procd_set_param limits nofile="16384 16384"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
