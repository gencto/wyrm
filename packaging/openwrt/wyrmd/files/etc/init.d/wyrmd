#!/bin/sh /etc/rc.common
# The WYRM broker under procd (ADR 0051 §1, §3).
#
# Before the broker starts, the first-boot script applies the configuration of the
# image's config region, once: the marker says that it did.
#
# No configuration, no broker. While /etc/wyrm/.first-boot-applied is absent (an image
# as it was published, a region that was refused) no instance is started: the broker
# would make the CA and the stores of a site nobody chose on the data partition, and an
# assembled image written later would meet them. The console says how to assemble.
#
# The broker runs as the user `wyrm` (as the systemd unit of docs/operations.md does)
# and is started as it is, not through `wyrmd update-guard`: self-update is off in
# images (ADR 0051 §3).

# shellcheck disable=SC2034 # read by rc.common
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

FIRST_BOOT=/usr/libexec/wyrm/first-boot.sh
DATA_PART=/usr/libexec/wyrm/data-part.sh
SITE=/usr/libexec/wyrm/site.sh
CONFIG=/etc/wyrm/wyrmd.json5
MARKER=/etc/wyrm/.first-boot-done
APPLIED=/etc/wyrm/.first-boot-applied
# what the first boot said when uci-defaults ran it, before the log daemon was up
EARLY=/tmp/wyrm-first-boot.log
DATA=/srv/wyrm

# to the system log (`logread -e wyrm`) and to the console of the device
tell() {
	# the log's tag says `wyrm` already
	msg=${1#wyrm: }
	logger -t wyrm "${msg#wyrm }"
	echo "$1" > /dev/console 2> /dev/null
}

tell_lines() {
	while IFS= read -r line; do
		tell "$line"
	done
}

# The uci-defaults script runs the first boot before the network starts. This is the
# second chance when that run did not finish (exit 4 or 5), and the place where an
# empty region is told, once per boot.
first_boot() {
	if [ -e "$MARKER" ]; then
		# applied by the early run of this boot: say so in the log
		if [ -s "$EARLY" ]; then
			tell_lines < "$EARLY"
		fi
		rm -f "$EARLY"
		return 0
	fi
	rm -f "$EARLY"
	rc=0
	out=$("$FIRST_BOOT" 2>&1) || rc=$?
	if [ -n "$out" ]; then
		echo "$out" | tell_lines
	fi
	# applied this late (5: applied, the wipe failed): the services that started with
	# the old files read the new ones
	if [ "$rc" -eq 0 ] || [ "$rc" -eq 5 ]; then
		reload_config
	fi
	return 0
}

# The device is named after its site (`wyrm-<site>`), so the gateway's certificate and
# the network show which broker it is. A name a person gave the device is kept: only
# OpenWrt's own name and a name this script gave are replaced.
host_name() {
	site=$("$SITE" "$CONFIG") || return 0
	case $site in
	'' | -* | *- | *[!a-z0-9-]*) return 0 ;;
	esac
	[ "${#site}" -le 58 ] || return 0
	name=wyrm-$site
	now=$(uci -q get system.@system[0].hostname)
	[ "$now" != "$name" ] || return 0
	case $now in
	OpenWrt | wyrm-*) ;;
	*) return 0 ;;
	esac
	uci -q set system.@system[0].hostname="$name" && uci -q commit system || return 0
	echo "$name" > /proc/sys/kernel/hostname
}

# What runs before the broker: the first boot, the data partition, the host name. Never
# while a broker runs: the data partition script unmounts and mounts its data_dir.
prepare() {
	first_boot
	if [ ! -e "$APPLIED" ]; then
		tell "wyrm: the broker is not started: no configuration is applied on this device"
		return 1
	fi
	# the data partition: made at the first boot, mounted at every boot. Without it the
	# broker does not start: its data would go into the root partition, and a partition
	# mounted later would hide it
	rc=0
	out=$("$DATA_PART" 2>&1) || rc=$?
	if [ -n "$out" ]; then
		echo "$out" | tell_lines
	fi
	[ "$rc" -eq 0 ] || return 1
	host_name
	# data_dir holds the keys of the site: the broker's user alone reads it. Root gives
	# the directory itself and nothing below it, and never through a link: what is
	# inside belongs to the broker's user, who could point a name anywhere.
	if [ -L "$DATA" ] || [ ! -d "$DATA" ]; then
		tell "wyrm: the broker is not started: $DATA is no directory"
		return 1
	fi
	chown -h wyrm:wyrm "$DATA"
	chmod 700 "$DATA"
}

# Whether procd runs the broker. Asked of ubus directly: procd_running would start a new
# message of the shell's JSON library and lose the service start_service is building.
broker_runs() {
	[ "$(ubus call service list '{"name":"wyrmd"}' 2> /dev/null |
		jsonfilter -e '@.wyrmd.instances.wyrmd.running' 2> /dev/null)" = true ]
}

# A stop ends when the broker has ended (at most 30 s): procd lists the instance for a
# moment after it was told to stop, and a start right after the stop (restart, reload)
# must find no broker, so that it runs the first boot and the data partition script.
service_stopped() {
	n=0
	# by the command line: the name `wyrmd` is also this script's
	while broker_runs || pgrep -f '^/usr/bin/wyrmd( |$)' > /dev/null 2>&1; do
		[ "$n" -lt 30 ] || break
		sleep 1
		n=$((n + 1))
	done
}

start_service() {
	# a start while the broker runs (`start` twice, a boot script) declares the same
	# instance again and procd keeps it running; an instance left out would be stopped
	if ! broker_runs; then
		prepare || return 0
	fi

	procd_open_instance wyrmd
	procd_set_param command /usr/libexec/wyrm/run.sh
	procd_set_param user wyrm
	procd_set_param group wyrm
	procd_set_param no_new_privs 1
	# the log daemon takes the broker's lines: no colour codes in them
	procd_set_param env NO_COLOR=1
	# start again after a crash: at most 8 times within an hour, 5 s apart
	procd_set_param respawn 3600 5 8
	# SIGTERM ends the broker cleanly (history flushed, links told to stop)
	procd_set_param term_timeout 20
	procd_set_param limits nofile="16384 16384"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# A reload is a restart. The broker reads its configuration only when it starts, and the
# data partition and the site rule are run only while no broker runs: rc.common's own
# reload runs start_service beside the running instance, and the site rule would move the
# files of a live broker.
reload_service() {
	stop
	start
}
