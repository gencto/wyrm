/// WYRM point driver as a WebAssembly component: the read/write surface of
/// one `Point` kind (ADR 0004), without its own transport. The world
/// imports nothing; network access will come only as explicit host imports
/// gated by `~def.capabilities` (`net:tcp:<cidr>:<port>`), never as WASI.
///
/// Data on the boundary is canonical CBOR: `point` is the point's
/// `~meta.cfg` map, a value is a WYRM `Value`, a reading is the `~val`
/// payload `{0: v, 1: q, 2: t}` (spec 03).
package wyrm:link@0.1.0;

world point {
  /// Called once per instance with the driver config as canonical CBOR.
  export init: func(config: list<u8>) -> result<_, string>;

  /// Read one point.
  export read: func(point: list<u8>) -> result<list<u8>, string>;

  /// Write one value to a point. No optimistic update: the framework reads
  /// the point back (ADR 0004).
  export write: func(point: list<u8>, value: list<u8>) -> result<_, string>;
}

/// TCP to the addresses and ports the link's `net` list allows (ADR 0012).
/// Addresses are IP literals; every timeout is capped at the time left in
/// the current call.
interface tcp {
  /// Open a connection; returns its handle (at most 4 open at a time).
  connect: func(addr: string, port: u16, timeout-ms: u32) -> result<u32, string>;

  /// Send all of `data`.
  send: func(conn: u32, data: list<u8>) -> result<_, string>;

  /// Up to `max` bytes (at most 64 KiB) as they arrive; empty at the end
  /// of the stream.
  recv: func(conn: u32, max: u32, timeout-ms: u32) -> result<list<u8>, string>;

  close: func(conn: u32);
}

/// A point driver with network access (ADR 0012): `point` plus `tcp`.
world driver {
  import tcp;

  export init: func(config: list<u8>) -> result<_, string>;
  export read: func(point: list<u8>) -> result<list<u8>, string>;
  export write: func(point: list<u8>, value: list<u8>) -> result<_, string>;
}
