//! `__NAME__` connector on the driver framework (ADR 0004).
//!
//! Tree: `<conn>/<device>/<point>`; kinds [`Conn`] → [`Dev`] → [`Point`].
//! The framework owns the tree, the generated actions (`add_*`, `edit`,
//! `remove`, `restart`, `enable`), validate-then-diff edits, typed states,
//! the per-connection owner task, polling only while subscribed, read-back
//! writes and the quality ladder. This file only does protocol I/O.
//!
//! Generated by `wyr new link`. The protocol below is a placeholder: one
//! text line per request over TCP, with a sequence number so that a reply
//! that arrives after a timeout is never taken for the next one.
//!
//! ```text
//! <seq> PING <station>                 → <seq> OK
//! <seq> READ <station> <addr>          → <seq> OK <number> | <seq> ERR <text>
//! <seq> WRITE <station> <addr> <number> → <seq> OK | <seq> ERR <text>
//! ```
//!
//! Error classes decide which node fails ([`DriverError`]):
//! I/O error or closed socket → `Transport` (reconnect with backoff),
//! no answer in time → `Device` (framework timeout, quality ladder),
//! `ERR` reply → `Point` (that point only).

#![forbid(unsafe_code)]

#[cfg(feature = "sim")]
pub mod sim;

use std::time::Duration;
use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
use tokio::net::TcpStream;
use wyrm_core::meta::Writable;
use wyrm_core::{NodeMeta, Value};
use wyrm_link_sdk::driver::{Driver, DriverError, Framework, PointId};
use wyrm_link_sdk::Params;

/// The `__NAME__` link: the framework running [`__TYPE__Driver`].
pub type __TYPE__ = Framework<__TYPE__Driver>;

/// Connection parameters (`connections/<id>`).
#[derive(Debug, Clone, PartialEq, Params)]
pub struct Conn {
    #[param(desc = "Host name or IP address")]
    pub host: String,
    #[param(default = 4000)]
    pub port: u16,
    /// Bound on each request.
    #[param(default = 1000, min = 100, max = 10000)]
    pub timeout_ms: u32,
}

/// Device parameters (`connections/<id>/devices/<id>`).
#[derive(Debug, Clone, PartialEq, Params)]
pub struct Dev {
    /// Station address on the connection.
    #[param(default = 1, min = 1, max = 247)]
    pub station: u8,
    #[param(default = 5.0, min = 0.1, max = 3600.0)]
    pub ping_s: f64,
}

/// Point parameters (`.../devices/<id>/points/<id>`).
#[derive(Debug, Clone, PartialEq, Params)]
pub struct Point {
    pub addr: u16,
    #[param(default = 1.0, min = 0.01, max = 3600.0)]
    pub poll_s: f64,
    #[param(default = false)]
    pub writable: bool,
    /// Engineering unit shown in `~meta.unit`.
    #[param(default = "")]
    pub unit: String,
}

pub struct Transport {
    io: BufReader<TcpStream>,
    seq: u32,
}

fn transport(e: std::io::Error) -> DriverError {
    DriverError::Transport(e.to_string())
}

impl Transport {
    /// Send one request and return the text after `OK`. Replies with an
    /// older sequence number (late answers) are skipped.
    async fn request(&mut self, body: &str) -> Result<String, DriverError> {
        self.seq = self.seq.wrapping_add(1);
        let seq = self.seq;
        self.io
            .write_all(format!("{seq} {body}\n").as_bytes())
            .await
            .map_err(transport)?;
        loop {
            let mut line = String::new();
            if self.io.read_line(&mut line).await.map_err(transport)? == 0 {
                return Err(DriverError::Transport("connection closed".into()));
            }
            let mut parts = line.trim_end().splitn(3, ' ');
            if parts.next().and_then(|s| s.parse::<u32>().ok()) != Some(seq) {
                continue; // late reply or fragment
            }
            return match (parts.next(), parts.next()) {
                (Some("OK"), rest) => Ok(rest.unwrap_or("").to_owned()),
                (Some("ERR"), msg) => Err(DriverError::Point(msg.unwrap_or("error").to_owned())),
                _ => Err(DriverError::Transport(format!("bad reply {line:?}"))),
            };
        }
    }
}

pub struct __TYPE__Driver;

impl Driver for __TYPE__Driver {
    const NAME: &'static str = "__NAME__";
    const VERSION: &'static str = env!("CARGO_PKG_VERSION");
    type Conn = Conn;
    type Dev = Dev;
    type Point = Point;
    type Transport = Transport;
    /// One read per point; group adjacent addresses here if the protocol
    /// can read blocks.
    type Plan = Vec<(PointId, Point)>;

    async fn open(conn: &Conn) -> Result<Transport, DriverError> {
        let connect = TcpStream::connect((conn.host.as_str(), conn.port));
        let timeout = Duration::from_millis(conn.timeout_ms.into());
        let stream = tokio::time::timeout(timeout, connect)
            .await
            .map_err(|_| DriverError::Transport("connect timeout".into()))?
            .map_err(transport)?;
        Ok(Transport {
            io: BufReader::new(stream),
            seq: 0,
        })
    }

    async fn ping(t: &mut Transport, dev: &Dev) -> Result<(), DriverError> {
        match t.request(&format!("PING {}", dev.station)).await {
            // A protocol error means the device answered: it is alive.
            Ok(_) | Err(DriverError::Point(_)) => Ok(()),
            Err(e) => Err(e),
        }
    }

    fn plan(_dev: &Dev, points: &[(PointId, Point)]) -> Self::Plan {
        points.to_vec()
    }

    async fn poll(
        t: &mut Transport,
        dev: &Dev,
        plan: &Self::Plan,
    ) -> Vec<(PointId, Result<Value, DriverError>)> {
        let mut out = Vec::with_capacity(plan.len());
        for (id, p) in plan {
            let r = t
                .request(&format!("READ {} {}", dev.station, p.addr))
                .await
                .and_then(|s| {
                    s.trim()
                        .parse::<f64>()
                        .map(Value::Float)
                        .map_err(|_| DriverError::Point(format!("not a number: {s:?}")))
                });
            let broken = matches!(r, Err(DriverError::Transport(_)));
            out.push((id.clone(), r));
            if broken {
                // The connection is gone: the rest of the batch fails with it.
                let e = DriverError::Transport("connection lost".into());
                out.extend(
                    plan[out.len()..]
                        .iter()
                        .map(|(id, _)| (id.clone(), Err(e.clone()))),
                );
                break;
            }
        }
        out
    }

    async fn write(
        t: &mut Transport,
        dev: &Dev,
        _id: &str,
        point: &Point,
        v: &Value,
    ) -> Result<(), DriverError> {
        if !point.writable {
            return Err(DriverError::Point("point is read-only".into()));
        }
        let x = v
            .as_f64()
            .ok_or_else(|| DriverError::Point("expected a number".into()))?;
        t.request(&format!("WRITE {} {} {x}", dev.station, point.addr))
            .await
            .map(|_| ())
    }

    fn point_meta(p: &Point) -> NodeMeta {
        let mut m = NodeMeta::number().writable(if p.writable {
            Writable::Write
        } else {
            Writable::Never
        });
        if !p.unit.is_empty() {
            m = m.unit(p.unit.clone());
        }
        m
    }

    fn poll_period(p: &Point) -> Duration {
        Duration::from_secs_f64(p.poll_s)
    }

    fn ping_period(dev: &Dev) -> Option<Duration> {
        Some(Duration::from_secs_f64(dev.ping_s))
    }

    fn io_timeout(conn: &Conn) -> Duration {
        Duration::from_millis(conn.timeout_ms.into())
    }
}
