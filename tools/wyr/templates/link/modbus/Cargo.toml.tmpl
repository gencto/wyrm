[package]
name = "__CRATE__"
description = "WYRM __NAME__ connector (Modbus TCP device) on the driver framework (ADR 0004)"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
authors.workspace = true

[features]
# In-process Modbus TCP simulator (the one of links/modbus) for tests and demos.
sim = ["dep:wyrm-link-modbus"]

[dependencies]
wyrm-core.workspace = true
wyrm-link-sdk.workspace = true
tokio = { workspace = true, features = ["rt", "time", "macros", "sync", "net"] }
tokio-modbus = { workspace = true, features = ["tcp"] }
tracing.workspace = true
wyrm-link-modbus = { workspace = true, features = ["sim"], optional = true }

[dev-dependencies]
__CRATE__ = { path = ".", features = ["sim"] }
wyrm-link-sdk = { workspace = true, features = ["harness"] }
tokio = { workspace = true, features = ["rt-multi-thread", "macros", "time"] }
