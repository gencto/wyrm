//! `__NAME__` connector: a Modbus TCP device on the driver framework
//! (ADR 0004).
//!
//! Tree: `<conn>/<device>/<point>`; kinds [`Conn`] → [`Dev`] → [`Point`].
//! The framework owns the tree, the generated actions (`add_*`, `edit`,
//! `remove`, `restart`, `enable`), validate-then-diff edits, typed states,
//! the per-connection owner task, polling only while subscribed, read-back
//! writes and the quality ladder. This file only does protocol I/O.
//!
//! Generated by `wyr new link --proto modbus`: 16-bit holding/input
//! registers with sign and linear scaling, reads batched in spans of up to
//! `max_regs` registers, writes with FC6. For the full data-type set
//! (32/64-bit, floats, BCD, strings, bits, FC22) see `links/modbus`; use
//! that link directly unless the device needs its own behaviour.
//!
//! Error classes decide which node fails ([`DriverError`]):
//! I/O error → `Transport` (reconnect with backoff), timeout → `Device`
//! (quality ladder), Modbus exception → `Point` (that point or span only).

#![forbid(unsafe_code)]

#[cfg(feature = "sim")]
pub mod sim;

use std::net::SocketAddr;
use std::time::Duration;
use tokio_modbus::client::{tcp, Context, Reader, Writer};
use tokio_modbus::slave::SlaveContext;
use tokio_modbus::{ExceptionCode, Slave};
use wyrm_core::meta::Writable;
use wyrm_core::{NodeMeta, Value};
use wyrm_link_sdk::driver::{Driver, DriverError, Framework, PointId};
use wyrm_link_sdk::{ParamEnum, Params};

/// The `__NAME__` link: the framework running [`__TYPE__Driver`].
pub type __TYPE__ = Framework<__TYPE__Driver>;

#[derive(Debug, Clone, Copy, PartialEq, Eq, ParamEnum)]
pub enum Table {
    Input,
    Holding,
}

#[derive(Debug, Clone, PartialEq, Params)]
pub struct Conn {
    #[param(desc = "Host name or IP address")]
    pub host: String,
    #[param(default = 502)]
    pub port: u16,
    /// Bound on each request.
    #[param(default = 1000, min = 100, max = 10000)]
    pub timeout_ms: u32,
}

#[derive(Debug, Clone, PartialEq, Params)]
pub struct Dev {
    #[param(min = 1, max = 247)]
    pub unit: u8,
    /// Register read as the liveness probe (an exception reply = alive).
    #[param(default = 0)]
    pub probe_addr: u16,
    #[param(default = 5.0, min = 0.1, max = 3600.0)]
    pub ping_s: f64,
    #[param(default = 125, min = 1, max = 125)]
    pub max_regs: u16,
}

#[derive(Debug, Clone, PartialEq, Params)]
pub struct Point {
    #[param(enum, default = "holding")]
    pub table: Table,
    pub addr: u16,
    /// Two's complement (i16) instead of u16.
    #[param(default = false)]
    pub signed: bool,
    /// value = raw · scale + offset
    #[param(default = 1.0)]
    pub scale: f64,
    #[param(default = 0.0)]
    pub offset: f64,
    #[param(default = 5.0, min = 0.01, max = 3600.0)]
    pub poll_s: f64,
    #[param(default = false)]
    pub writable: bool,
    /// Engineering unit shown in `~meta.unit`.
    #[param(default = "")]
    pub unit: String,
}

impl Point {
    fn decode(&self, raw: u16) -> f64 {
        let x = if self.signed {
            f64::from(raw as i16)
        } else {
            f64::from(raw)
        };
        x * self.scale + self.offset
    }

    fn encode(&self, v: f64) -> Result<u16, DriverError> {
        let x = ((v - self.offset) / self.scale).round();
        let (lo, hi) = if self.signed {
            (f64::from(i16::MIN), f64::from(i16::MAX))
        } else {
            (0.0, f64::from(u16::MAX))
        };
        if !x.is_finite() || x < lo || x > hi {
            return Err(DriverError::Point(format!("{v} is out of range")));
        }
        Ok(if self.signed {
            (x as i16) as u16
        } else {
            x as u16
        })
    }
}

pub struct Transport {
    ctx: Context,
    timeout: Duration,
}

/// One read request and the points it serves.
pub struct Span {
    table: Table,
    start: u16,
    count: u16,
    members: Vec<(PointId, Point)>,
}

type Reply<T> = Result<Result<T, ExceptionCode>, DriverError>;

/// Run one request with the timeout and sort the outcome.
async fn io<T>(
    timeout: Duration,
    f: impl std::future::Future<Output = tokio_modbus::Result<T>>,
) -> Reply<T> {
    match tokio::time::timeout(timeout, f).await {
        Err(_) => Err(DriverError::Device("request timed out".into())),
        Ok(Err(e)) => Err(DriverError::Transport(e.to_string())),
        Ok(Ok(r)) => Ok(r),
    }
}

fn exception(e: ExceptionCode) -> DriverError {
    DriverError::Point(format!("device exception {e:?}"))
}

impl Transport {
    async fn read(&mut self, table: Table, addr: u16, n: u16) -> Reply<Vec<u16>> {
        let t = self.timeout;
        Ok(match table {
            Table::Input => io(t, self.ctx.read_input_registers(addr, n)).await?,
            Table::Holding => io(t, self.ctx.read_holding_registers(addr, n)).await?,
        })
    }
}

pub struct __TYPE__Driver;

impl Driver for __TYPE__Driver {
    const NAME: &'static str = "__NAME__";
    const VERSION: &'static str = env!("CARGO_PKG_VERSION");
    type Conn = Conn;
    type Dev = Dev;
    type Point = Point;
    type Transport = Transport;
    type Plan = Vec<Span>;

    async fn open(conn: &Conn) -> Result<Transport, DriverError> {
        let timeout = Duration::from_millis(conn.timeout_ms.into());
        let target = format!("{}:{}", conn.host, conn.port);
        let addr: SocketAddr = tokio::time::timeout(timeout, tokio::net::lookup_host(&target))
            .await
            .map_err(|_| DriverError::Transport(format!("resolve {target}: timeout")))?
            .map_err(|e| DriverError::Transport(format!("resolve {target}: {e}")))?
            .next()
            .ok_or_else(|| DriverError::Transport(format!("resolve {target}: no address")))?;
        let ctx = tokio::time::timeout(timeout, tcp::connect_slave(addr, Slave(1)))
            .await
            .map_err(|_| DriverError::Transport(format!("connect {target}: timeout")))?
            .map_err(|e| DriverError::Transport(format!("connect {target}: {e}")))?;
        Ok(Transport { ctx, timeout })
    }

    async fn ping(t: &mut Transport, dev: &Dev) -> Result<(), DriverError> {
        t.ctx.set_slave(Slave(dev.unit));
        // Any answer, exception included, means the device is alive.
        t.read(Table::Holding, dev.probe_addr, 1).await.map(|_| ())
    }

    /// Spans per table: sorted by address, each at most `max_regs` long.
    fn plan(dev: &Dev, points: &[(PointId, Point)]) -> Vec<Span> {
        let mut sorted = points.to_vec();
        sorted.sort_by_key(|(_, p)| (p.table == Table::Holding, p.addr));
        let mut spans: Vec<Span> = Vec::new();
        for (id, p) in sorted {
            match spans.last_mut() {
                Some(s) if s.table == p.table && p.addr - s.start < dev.max_regs => {
                    s.count = s.count.max(p.addr - s.start + 1);
                    s.members.push((id, p));
                }
                _ => spans.push(Span {
                    table: p.table,
                    start: p.addr,
                    count: 1,
                    members: vec![(id, p)],
                }),
            }
        }
        spans
    }

    async fn poll(
        t: &mut Transport,
        dev: &Dev,
        plan: &Self::Plan,
    ) -> Vec<(PointId, Result<Value, DriverError>)> {
        t.ctx.set_slave(Slave(dev.unit));
        let mut out = Vec::new();
        for s in plan {
            let r = t.read(s.table, s.start, s.count).await;
            for (id, p) in &s.members {
                let v = match &r {
                    Err(e) => Err(e.clone()),
                    Ok(Err(e)) => Err(exception(*e)),
                    Ok(Ok(regs)) => regs
                        .get(usize::from(p.addr - s.start))
                        .map(|raw| Value::Float(p.decode(*raw)))
                        .ok_or_else(|| DriverError::Point("short read".into())),
                };
                out.push((id.clone(), v));
            }
            if matches!(r, Err(DriverError::Transport(_))) {
                break; // the framework reconnects; the rest waits for the next poll
            }
        }
        out
    }

    async fn write(
        t: &mut Transport,
        dev: &Dev,
        _id: &str,
        point: &Point,
        v: &Value,
    ) -> Result<(), DriverError> {
        if !point.writable || point.table != Table::Holding {
            return Err(DriverError::Point("point is read-only".into()));
        }
        let x = v
            .as_f64()
            .ok_or_else(|| DriverError::Point("expected a number".into()))?;
        let raw = point.encode(x)?;
        t.ctx.set_slave(Slave(dev.unit));
        io(t.timeout, t.ctx.write_single_register(point.addr, raw))
            .await?
            .map_err(exception)
    }

    fn point_meta(p: &Point) -> NodeMeta {
        let mut m = NodeMeta::number().writable(if p.writable && p.table == Table::Holding {
            Writable::Write
        } else {
            Writable::Never
        });
        if !p.unit.is_empty() {
            m = m.unit(p.unit.clone());
        }
        m
    }

    fn poll_period(p: &Point) -> Duration {
        Duration::from_secs_f64(p.poll_s)
    }

    fn ping_period(dev: &Dev) -> Option<Duration> {
        Some(Duration::from_secs_f64(dev.ping_s))
    }

    fn io_timeout(conn: &Conn) -> Duration {
        Duration::from_millis(conn.timeout_ms.into())
    }
}
