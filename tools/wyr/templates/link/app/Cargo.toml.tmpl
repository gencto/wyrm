[package]
name = "__CRATE__"
description = "WYRM __NAME__ portable link (ADR 0023): one App embedded, as a process and as a WASM component"
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
authors.workspace = true

[lib]
# cdylib: the WASM component (`--features wasm`, wasm32-unknown-unknown);
# rlib: the process binary and the tests
crate-type = ["cdylib", "rlib"]

[[bin]]
name = "__CRATE__"
required-features = ["process"]

[features]
# The process link: `wyrm_link_sdk::process::main::<Portable<App>>()`.
process = ["dep:wyrm-link-sdk", "wyrm-link-sdk/process", "dep:wyrm-link-portable"]
# The WASM component: `wyrm_link_guest::export!(App)`.
wasm = ["dep:wyrm-link-guest"]

[dependencies]
# Only these build for wasm32-unknown-unknown: keep the others optional.
wyrm-core.workspace = true
wyrm-link-api.workspace = true
wyrm-link-guest = { workspace = true, optional = true }
wyrm-link-sdk = { workspace = true, optional = true }
wyrm-link-portable = { workspace = true, optional = true }

[dev-dependencies]
wyrm-link-sdk = { workspace = true, features = ["harness"] }
wyrm-link-portable.workspace = true
tokio = { workspace = true, features = ["rt-multi-thread", "macros", "time"] }

# `wyr link pack` (ADR 0021, 0023): a `wasm` package (the component, for every
# host); `--kind process` packs the binary built with `features`.
# `capabilities`, granted at install: `net` (TCP allowlist, ADR 0012),
# `store_mb` (default 1, at most 64), `memory_mb` (default 64, at most 512),
# `call_ms` (default 2000, at most 10000). Grants on other points:
# `requester = [{ path = "wy/{site}/downstream/<link>", level = "read" }]`.
[package.metadata.wyrm-link]
name = "__NAME__"
kind = "wasm"
features = ["process"]
capabilities = { store_mb = 1 }
