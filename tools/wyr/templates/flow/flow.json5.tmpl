// Flow __ID__ — `wy/<site>/dataflows/__ID__/~def` (spec 06).
// Generated by `wyr new flow`. Check:  wyr flow validate <site> <this file>
// Deploy:  wyr --key admin.key flow deploy <site> <this file>   (or `wyr dev`)
//
// Node types: subscribe, timer, const, liveliness, expression, scale,
// deadband, window, alarm, latch, delay, filter, publish, invoke, set, wasm.
// Ports: <node>.out / <node>.in; expression inputs are <node>.in.<name>,
// alarm outputs are <node>.out (bool) and <node>.event (map).
// Keys without `wy/` are relative to the site: "downstream/mock/g0/p0".
{
  id: "__ID__",
  version: 1,            // raise on every deploy (the engine ignores ≤ current; `wyr dev` raises it for you)
  enabled: true,
  description: "__ID__: average of a point, high alarm",
  nodes: {
    src: { type: "subscribe", key: "downstream/mock/g0/p0" },
    avg: { type: "window", kind: "tumbling", size_s: 10, fn: "avg" },
    // rhai; inputs are maps {v, q, t, age_ms}; `state` keeps values between runs
    f: { type: "expression", inputs: ["avg"], expr: "avg.v * 9.0 / 5.0 + 32.0" },
    high: { type: "alarm", high: 28, hysteresis: 0.5, delay_s: 5 },
    // publish → wy/<site>/dataflows/__ID__/nodes/<node>
    avg_out: { type: "publish", node: "avg", meta: { type: "number", unit: "°C" } },
    f_out: { type: "publish", node: "avg_f", meta: { type: "number", unit: "°F" } },
    alarm_out: { type: "publish", node: "alarm" },
    // Commands need `permissions.maxperm: "write"` and a proof per target at deploy:
    // fan: { type: "set", path: "downstream/mock/g0/p1", on: "change" },
  },
  edges: [
    ["src.out", "avg.in"],
    ["avg.out", "f.in.avg"],
    ["avg.out", "avg_out.in"],
    ["f.out", "f_out.in"],
    ["avg.out", "high.in"],
    ["high.out", "alarm_out.in"],
  ],
  policy: { overflow: "drop_oldest", queue: 64, state_flush_s: 30 },
}
