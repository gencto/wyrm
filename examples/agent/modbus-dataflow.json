{
  "about": "Demo (examples/demo/run.sh): a Modbus device ahu2 on edge with four points, its history on edge and on central, and a dataflow that transforms two points and, on each change, writes a control value to another link (mockdev knob). Run through central's gateway: wyrm-agent --gateway http://127.0.0.1:8445 run examples/agent/modbus-dataflow.json [--apply]",
  "steps": [
    { "invoke": "wy/edge/downstream/modbus/line1", "action": "add_device",
      "args": { "name": "ahu2", "unit": 1, "ping": "probe", "probe_table": "holding", "probe_addr": 0 },
      "unless": "wy/edge/downstream/modbus/line1/ahu2" },
    { "wait": "wy/edge/downstream/modbus/line1/ahu2", "timeout_s": 15 },

    { "invoke": "wy/edge/downstream/modbus/line1/ahu2", "action": "add_point",
      "args": { "name": "count", "table": "holding", "addr": 0, "dtype": "u16", "poll_s": 1 },
      "unless": "wy/edge/downstream/modbus/line1/ahu2/count" },
    { "invoke": "wy/edge/downstream/modbus/line1/ahu2", "action": "add_point",
      "args": { "name": "temp", "table": "input", "addr": 1, "dtype": "i16", "scale": 0.1, "unit": "°C", "poll_s": 1 },
      "unless": "wy/edge/downstream/modbus/line1/ahu2/temp" },
    { "invoke": "wy/edge/downstream/modbus/line1/ahu2", "action": "add_point",
      "args": { "name": "sp", "table": "holding", "addr": 20, "dtype": "f32", "regs": 2, "unit": "°C", "writable": true, "poll_s": 1 },
      "unless": "wy/edge/downstream/modbus/line1/ahu2/sp" },
    { "invoke": "wy/edge/downstream/modbus/line1/ahu2", "action": "add_point",
      "args": { "name": "mode", "table": "holding", "addr": 30, "dtype": "u16", "writable": true, "poll_s": 1 },
      "unless": "wy/edge/downstream/modbus/line1/ahu2/mode" },
    { "expect": "wy/edge/downstream/modbus/line1/ahu2/count", "changes": true, "timeout_s": 15 },
    { "expect": "wy/edge/downstream/modbus/line1/ahu2/temp", "equals": 21.5, "timeout_s": 15 },

    { "invoke": "wy/edge/sys/history", "action": "add_watch_group",
      "args": { "name": "ahu2", "logging_type": "All Data" },
      "unless": "wy/edge/sys/history/ahu2" },
    { "wait": "wy/edge/sys/history/ahu2", "timeout_s": 10 },
    { "invoke": "wy/edge/sys/history/ahu2", "action": "add_watch_path",
      "args": { "path": "downstream/modbus/line1/ahu2/count" }, "ok_if_error": "is watched" },
    { "invoke": "wy/edge/sys/history/ahu2", "action": "add_watch_path",
      "args": { "path": "downstream/modbus/line1/ahu2/temp" }, "ok_if_error": "is watched" },

    { "invoke": "wy/central/sys/history", "action": "add_watch_group",
      "args": { "name": "edge_ahu2", "logging_type": "All Data" },
      "unless": "wy/central/sys/history/edge_ahu2" },
    { "wait": "wy/central/sys/history/edge_ahu2", "timeout_s": 10 },
    { "invoke": "wy/central/sys/history/edge_ahu2", "action": "add_watch_path",
      "args": { "path": "wy/edge/downstream/modbus/line1/ahu2/count" }, "ok_if_error": "is watched" },

    { "deploy": "wy/edge/dataflows",
      "def": {
        "id": "ahu2_ctl",
        "description": "ahu2: count mod 10 × 10 → mockdev knob on change; temp in °F; a warm flag",
        "nodes": {
          "count":  { "type": "subscribe", "key": "downstream/modbus/line1/ahu2/count" },
          "temp":   { "type": "subscribe", "key": "downstream/modbus/line1/ahu2/temp" },
          "mod":    { "type": "modulo", "modulo": 10 },
          "cmd":    { "type": "scale", "k": 10 },
          "f":      { "type": "scale", "k": 1.8, "b": 32 },
          "limit":  { "type": "number", "value": 25 },
          "warm":   { "type": "if", "op": ">", "then": "warm", "else": "ok" },
          "knob":   { "type": "set", "path": "downstream/mockdev/bench/rig1/knob", "on": "change" },
          "out_cmd":  { "type": "publish", "node": "knob_cmd" },
          "out_f":    { "type": "publish", "node": "temp_f", "meta": { "unit": "°F" } },
          "out_warm": { "type": "publish", "node": "state" }
        },
        "edges": [
          ["count.out", "mod.in"], ["mod.remainder", "cmd.in"],
          ["cmd.out", "knob.in"], ["cmd.out", "out_cmd.in"],
          ["temp.out", "f.in"], ["f.out", "out_f.in"],
          ["temp.out", "warm.in.0"], ["limit.out", "warm.in.1"], ["warm.out", "out_warm.in"]
        ],
        "permissions": { "maxperm": "write" }
      } },
    { "expect": "wy/edge/dataflows/ahu2_ctl/nodes/knob_cmd", "min": 0, "max": 90, "timeout_s": 20 },
    { "expect": "wy/edge/dataflows/ahu2_ctl/nodes/temp_f", "min": 70.6, "max": 70.8, "timeout_s": 20 },
    { "expect": "wy/edge/dataflows/ahu2_ctl/nodes/state", "equals": "ok", "timeout_s": 20 },
    { "expect": "wy/edge/downstream/mockdev/bench/rig1/knob", "changes": true, "timeout_s": 30 }
  ]
}
