// Demo: the downstream site `edge` with the connectors (see run.sh).
{
  site: "edge",
  profile: "prod",
  data_dir: "./data/edge",
  listen: ["tcp/127.0.0.1:7457", "tls/127.0.0.1:7458"],
  admin_keys: [],
  peers: {
    // central's CA and the certificate central issued for edge
    upstream: [{
      site: "central",
      endpoint: "quic/127.0.0.1:7449",
      ca: "./data/central/pki/ca.pem",
      cert: "./data/central/peers/edge/broker.pem",
      key: "./data/central/peers/edge/broker.key",
      // central's users may run sys actions here too (ADR 0018); plant
      // does not allow edge, so plant's sys stays closed from above
      allow_config: true,
    }],
    upstream_val_hz: 5,
    // The middle of the chain: plant connects here.
    listen: "quic/127.0.0.1:7459",
    // another broker asks for its certificate here (ADR 0015)
    enroll: "quic/127.0.0.1:7460",
    downstream: [{ site: "plant" }],
  },
  gateway: { listen: "127.0.0.1:8444", admin_user: "admin" },
  // "Install Link ▸ from Repository": the index of examples/packages/out,
  // served by run.sh (build it with examples/packages/build.sh).
  packages: { repository: "http://127.0.0.1:8090/index.json" },
  links: {
    // Plain mock: 16 points at 2 Hz on a two-level folder tree.
    mock: { driver: "mock", params: { points: 16, rate_hz: 2, depth: 2, fanout: 2 } },
    // Framework mock (ADR 0004): connections → devices → points, with the
    // generated add_*/edit/remove/restart/stop actions; edits survive restarts.
    mockdev: {
      driver: "mockdev",
      params: {
        connections: {
          bench: {
            devices: {
              rig1: {
                ping_s: 1,
                points: {
                  wave: { kind: "wave", poll_s: 0.5 },
                  count: { kind: "counter", poll_s: 1 },
                  knob: { kind: "constant", writable: true, initial: 50, poll_s: 1 },
                },
              },
            },
          },
        },
      },
    },
    // Modbus TCP as a supervised process against wyrm-modbus-sim (port 5020).
    modbus: {
      driver: "modbus",
      mode: "process",
      params: {
        connections: {
          line1: {
            host: "127.0.0.1",
            port: 5020,
            timeout_ms: 1000,
            devices: {
              ahu1: {
                unit: 1,
                ping: "probe",
                probe_table: "holding",
                probe_addr: 0,
                points: {
                  supply_temp: { table: "input", addr: 1, dtype: "i16", scale: 0.1, unit: "°C", poll_s: 1 },
                  counter: { table: "holding", addr: 0, dtype: "u16", poll_s: 1 },
                  setpoint: { table: "holding", addr: 10, dtype: "f32", writable: true, unit: "°C", poll_s: 1 },
                  fan: { table: "coil", addr: 3, dtype: "binary", writable: true, poll_s: 1 },
                  // the fan's state as a separate read-only point: a scheduler
                  // target on `fan` confirms on it (`confirm: feedback`)
                  fan_status: { table: "coil", addr: 3, dtype: "binary", poll_s: 1 },
                },
              },
            },
          },
        },
      },
    },
    // Modbus slave (ADR 0024): masters on 127.0.0.1:15502 read the tree's
    // values; `remote_sp` takes master writes.
    modbus_slave: {
      driver: "modbus",
      params: {
        connections: {
          s1: {
            kind: "ip_slave",
            listen_host: "127.0.0.1",
            listen_port: 15502,
            devices: {
              unit1: {
                unit: 1,
                points: {
                  temp: { table: "holding", addr: 0, dtype: "f32", writable: true, unit: "°C" },
                  remote_sp: { table: "holding", addr: 2, dtype: "u16", writable: true, writable_by_master: true },
                  run: { table: "coil", addr: 0, dtype: "binary", writable: true },
                },
              },
            },
          },
        },
      },
    },
    // HTTP/REST JSON against wyrm-http-sim (port 18090), docs/http.md.
    http: {
      driver: "http",
      params: {
        connections: {
          sim: {
            base_url: "http://127.0.0.1:18090/api",
            devices: {
              data: {
                path: "/data",
                points: {
                  power: { path: "$.meter.power", unit: "W", poll_s: 2 },
                  energy: { path: "$.meter.energy", unit: "Wh", poll_s: 2 },
                  b: { path: "$.items[?(@.id==\"b\")].v", poll_s: 2 },
                  total: { path: "$.items[*].v", aggregate: "sum", poll_s: 2 },
                },
              },
              resource: {
                path: "/resource",
                points: {
                  setpoint: {
                    path: "$.setpoint", writable: true, poll_s: 5,
                    write_body: "{\"setpoint\": {{value}}}",
                  },
                },
              },
            },
          },
        },
      },
    },
    // SNMP v2c against wyrm-snmp-sim (port 1161), docs/snmp.md. The
    // community here is for the demo only.
    snmp: {
      driver: "snmp",
      params: {
        connections: {
          sim: {
            kind: "snmp_v2c", host: "127.0.0.1", port: 1161, community: "public",
            devices: {
              agent: {
                points: {
                  uptime: { oid: "1.3.6.1.2.1.1.3.0", conv: "timeticks_s", unit: "s" },
                  eth0_in: { oid: "1.3.6.1.2.1.31.1.1.1.6", kind: "table_column", index: "1",
                             conv: "rate_per_s", scale: 8, unit: "bit/s", poll_s: 5 },
                  contact: { oid: "1.3.6.1.2.1.1.4.0", conv: "string", writable: true,
                             set_type: "octet_string" },
                },
              },
            },
          },
        },
      },
    },
    // Prometheus scrape of wyrm-prometheus-sim (port 19101), docs/prometheus.md.
    prometheus: {
      driver: "prometheus",
      params: {
        connections: {
          sim: {
            url: "http://127.0.0.1:19101/metrics",
            scrape_s: 5,
            devices: {
              a: {
                labels: "instance=\"a\"",
                points: {
                  temp: { selector: "sim_temperature_celsius", unit: "°C" },
                },
              },
              all: {
                points: {
                  req_rate: { selector: "sim_requests_total", aggregate: "sum", mode: "rate_per_s", unit: "1/s" },
                },
              },
            },
          },
        },
      },
    },
  },
}
