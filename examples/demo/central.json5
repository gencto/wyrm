// Demo: the upstream site `central` (see run.sh). It reads the downstream
// site `edge` over QUIC + mTLS, and through edge the site `plant` (a chain
// plant → edge → central). Central's CA issues edge's certificate
// (`wyrmd ca` in run.sh: data/central/peers/edge/), as ADR 0015 says.
{
  site: "central",
  profile: "prod",
  data_dir: "./data/central",
  listen: ["tcp/127.0.0.1:7447", "tls/127.0.0.1:7448"],
  admin_keys: [],
  peers: {
    listen: "quic/127.0.0.1:7449",
    // another broker asks for its certificate here (ADR 0015)
    enroll: "quic/127.0.0.1:7450",
    // edge relays plant: central reads wy/plant/** through edge.
    downstream: [{ site: "edge", via: ["plant"] }],
  },
  // App login: user admin, password from WYRM_GATEWAY_ADMIN_PASSWORD.
  gateway: { listen: "127.0.0.1:8445", admin_user: "admin" },
  links: {
    // A small mock on the central site itself.
    hq: { driver: "mock", params: { points: 6, rate_hz: 1, depth: 1, fanout: 2 } },
  },
}
