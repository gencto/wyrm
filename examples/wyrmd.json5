// wyrmd example config. Run: cargo run -p wyrmd -- -c examples/wyrmd.json5
{
  site: "local",
  // prod: loopback sessions are requesters only; dev: loopback may do everything.
  profile: "prod",
  data_dir: "./data",
  // WAL head anchors of the control-plane state and the audit journal, on
  // another medium than data_dir: a WAL cut at the end is refused at start.
  // Create the directory, then run `wyrmd -c <cfg> init-anchors` once.
  // state_anchor_dir: "/var/lib/wyrm-anchor",
  // Plain tcp only on loopback (principle 6). The tls/ listener serves
  // process links and remote devices with CA-issued certificates (mTLS).
  listen: ["tcp/127.0.0.1:7447", "tls/127.0.0.1:7448"],
  // Public key printed by `wyr keygen`. Without it every set/invoke is denied.
  admin_keys: [],
  // Certificate CNs of engineering tools with requester rights over TLS.
  operators: [],
  // Other sites (QUIC + mTLS, CN broker:<site>). Uncomment one side:
  // peers: { upstream: [{ site: "central", endpoint: "quic/10.0.0.1:7449", ca: "central-ca.pem" }], upstream_val_hz: 1 },
  // peers: { listen: "quic/0.0.0.0:7449", downstream: [{ site: "edge", ca: "edge-ca.pem" }] },
  // User gateway; first admin password from WYRM_GATEWAY_ADMIN_PASSWORD.
  // gateway: { listen: "127.0.0.1:8080", admin_user: "admin" },
  // Hard rlimits each process link sets on itself (0 = none; core dumps are
  // always off). memory_mb is applied on Linux only.
  // link_limits: { memory_mb: 1024, open_files: 4096 },
  links: {
    // Embedded mock connector: wy/local/down/mock/**
    mock: { driver: "mock", params: { points: 100, rate_hz: 1, depth: 2, fanout: 4 } },
    // Modbus TCP as a supervised process (`wyrmd link modbus`), mTLS CN = plc1.
    // Simulator: cargo run -p wyrm-link-modbus --features bin --bin wyrm-modbus-sim
    plc1: {
      driver: "modbus",
      mode: "process",
      // Driver framework tree (ADR 0004): connections → devices → points.
      params: {
        // A process link cannot see the broker's `~val` storage subscription
        // through the ACL, so poll regardless of subscribers.
        poll_unsubscribed: true,
        connections: {
          line1: {
            host: "127.0.0.1",
            port: 5020,
            timeout_ms: 1000,
            write_mode: "auto",
            devices: {
              ahu1: {
                unit: 1,
                ping: "probe",
                probe_table: "holding",
                probe_addr: 0,
                points: {
                  supply_temp: { table: "input", addr: 1, dtype: "i16", scale: 0.1, unit: "°C", poll_s: 1 },
                  counter: { table: "holding", addr: 0, dtype: "u16", poll_s: 1 },
                  setpoint: { table: "holding", addr: 10, dtype: "f32", writable: true, unit: "°C", poll_s: 1 },
                  fan: { table: "coil", addr: 3, dtype: "binary", writable: true, poll_s: 1 },
                },
              },
            },
          },
        },
      },
    },
  },
}
